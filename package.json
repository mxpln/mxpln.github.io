{
  "name": "mxpln-garden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "python build.py",
    "test": "python -m unittest discover -s test -p 'test_*.py'",
    "verify": "python -m py_compile build.py && python -m unittest discover -s test -p 'test_*.py'",
    "new:link": "node scripts/new-content.mjs link",
    "publish": "node scripts/publish.mjs",
    "deploy": "python build.py && node scripts/publish.mjs"
  }
}
